#!/usr/bin/env zsh

set -e

if [[ -z "${CLOUDFLARED_TOKEN}" ]] ; then
  echo "'CLOUDFLARED_TOKEN' environment variable not set: Bypass Server"
  if [[ -z "${CLOUDFLARED_TUNNELS}" ]] ; then
    echo "'CLOUDFLARED_TUNNELS' environment variable not set: Bypass Client"
    sleep 60
    exit 99
  fi
fi

